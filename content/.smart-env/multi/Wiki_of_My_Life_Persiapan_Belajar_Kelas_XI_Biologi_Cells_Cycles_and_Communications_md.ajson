b5eabd@9.85:49/Signaling-in-Single-Celled-Org","line":40},{"title":"CC BY 3.0","target":"https://creativecommons.org/licenses/by/3.0/us/","line":40},{"title":"Image of a _Staphylococcus aureus_ biofilm on the surface of a catheter.","target":"https://cdn.kastatic.org/ka-perseus-images/6cfccacb8d1b2d777f412f7b213935a11b45df3e.png","line":48,"embedded":true},{"title":"Signaling in single-celled organisms: Figure 3","target":"http://cnx.org/contents/185cbf87-c72e-48f5-b51e-f14f21b5eabd@9.85:49/Signaling-in-Single-Celled-Org","line":50},{"title":"CC BY 3.0","target":"http://creativecommons.org/licenses/by/3.0/","line":50}],"class_name":"SmartBlock"},
