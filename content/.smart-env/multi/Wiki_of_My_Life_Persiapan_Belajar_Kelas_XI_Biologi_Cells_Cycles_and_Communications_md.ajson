 labeled healthy cell.","target":"https://cdn.kastatic.org/ka-perseus-images/8dd01535f30c44b2369198ff727bf85a1d569a61.png","line":11,"embedded":true},{"title":"Adaptive immune response: Figure 7","target":"http://cnx.org/contents/GFy_h8cu@9.87:etZobsU-@6/Adaptive-Immune-Response","line":13},{"title":"CC BY 3.0","target":"http://creativecommons.org/licenses/by/3.0/","line":13}],"class_name":"SmartBlock"},
