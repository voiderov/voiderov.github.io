 the word response.","target":"https://cdn.kastatic.org/ka-perseus-images/72d570876a67f6c4012f5900a66878d4e21b5407.png","line":13,"embedded":true},{"title":"cellular responses","target":"https://www.khanacademy.org/science/biology/cell-signaling/mechanisms-of-cell-signaling/a/cellular-response","line":15},{"title":"signal relay","target":"https://www.khanacademy.org/science/biology/cell-signaling/mechanisms-of-cell-signaling/a/intracellular-signal-transduction","line":15},{"title":"ligands and receptors","target":"https://www.khanacademy.org/science/biology/cell-signaling/mechanisms-of-cell-signaling/a/signal-perception","line":15}],"class_name":"SmartBlock"},
