ecd2721834987bc4.png","line":11,"embedded":true},{"title":"Signaling molecules and cellular receptors: Figure 1","target":"http://cnx.org/contents/185cbf87-c72e-48f5-b51e-f14f21b5eabd@9.87:46/Signaling-Molecules-and-Cellul","line":14},{"title":"CC BY 3.0","target":"http://creativecommons.org/licenses/by/3.0/","line":14}],"class_name":"SmartBlock"},
